{
  "name": "dsh-memj",
  "displayName": "DSH 记忆系统 memj",
  "description": "以「封面 + 正文」组织知识的 DSH 记忆插件：封面只写在项目级 handoff 文档里（唯一源头），正文独立落盘成文档；封面按项目 → 主题 → 全局三层聚合。库在 ~/.dsh-memj/，拷一个目录即迁移。",
  "version": "0.1.2",
  "author": "jojoman2024",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "handoff",
    "knowledge"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.5-rc.2 <0.1.6-0 || >=0.1.6-0 <0.1.7-0 || >=0.1.7-0 <0.2.0-0 || >=0.2.0-0 <0.2.1-0 || >=0.2.1-0 <0.3.0-0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:raw": "tsdown && node scripts/copy-web.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "test": "node scripts/run-all-tests.mjs",
    "check": "pnpm run typecheck && pnpm run build && pnpm run test",
    "prepublishOnly": "node scripts/build.mjs && node scripts/check-pack.mjs && node scripts/check-peer-range.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!lib/offline-bundle.js",
    "!lib/offline-bundle.d.ts",
    "cordis.patch.yml",
    "README.md",
    "docs/screenshots"
  ],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/jojoman2024/dsh-memj.git" },
  "homepage": "https://github.com/jojoman2024/dsh-memj#readme",
  "bugs": { "url": "https://github.com/jojoman2024/dsh-memj/issues" },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": ">=0.1.5-rc.2 <0.1.6-0 || >=0.1.6-0 <0.1.7-0 || >=0.1.7-0 <0.2.0-0 || >=0.2.0-0 <0.2.1-0 || >=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.1.5-rc.2 <0.1.6-0 || >=0.1.6-0 <0.1.7-0 || >=0.1.7-0 <0.2.0-0 || >=0.2.0-0 <0.2.1-0 || >=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-atomic-write": ">=0.1.5-rc.2 <0.1.6-0 || >=0.1.6-0 <0.1.7-0 || >=0.1.7-0 <0.2.0-0 || >=0.2.0-0 <0.2.1-0 || >=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-commands": ">=0.1.5-rc.2 <0.1.6-0 || >=0.1.6-0 <0.1.7-0 || >=0.1.7-0 <0.2.0-0 || >=0.2.0-0 <0.2.1-0 || >=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.5-rc.2 <0.1.6-0 || >=0.1.6-0 <0.1.7-0 || >=0.1.7-0 <0.2.0-0 || >=0.2.0-0 <0.2.1-0 || >=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-session": ">=0.1.5-rc.2 <0.1.6-0 || >=0.1.6-0 <0.1.7-0 || >=0.1.7-0 <0.2.0-0 || >=0.2.0-0 <0.2.1-0 || >=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.1.5-rc.2 <0.1.6-0 || >=0.1.6-0 <0.1.7-0 || >=0.1.7-0 <0.2.0-0 || >=0.2.0-0 <0.2.1-0 || >=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.5-rc.2 <0.1.6-0 || >=0.1.6-0 <0.1.7-0 || >=0.1.7-0 <0.2.0-0 || >=0.2.0-0 <0.2.1-0 || >=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-commands": ">=0.1.5-rc.2 <0.1.6-0 || >=0.1.6-0 <0.1.7-0 || >=0.1.7-0 <0.2.0-0 || >=0.2.0-0 <0.2.1-0 || >=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-home-paths": ">=0.1.5-rc.2 <0.1.6-0 || >=0.1.6-0 <0.1.7-0 || >=0.1.7-0 <0.2.0-0 || >=0.2.0-0 <0.2.1-0 || >=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.5-rc.2 <0.1.6-0 || >=0.1.6-0 <0.1.7-0 || >=0.1.7-0 <0.2.0-0 || >=0.2.0-0 <0.2.1-0 || >=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.5-rc.2 <0.1.6-0 || >=0.1.6-0 <0.1.7-0 || >=0.1.7-0 <0.2.0-0 || >=0.2.0-0 <0.2.1-0 || >=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.5-rc.2 <0.1.6-0 || >=0.1.6-0 <0.1.7-0 || >=0.1.7-0 <0.2.0-0 || >=0.2.0-0 <0.2.1-0 || >=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-timeout": ">=0.1.5-rc.2 <0.1.6-0 || >=0.1.6-0 <0.1.7-0 || >=0.1.7-0 <0.2.0-0 || >=0.2.0-0 <0.2.1-0 || >=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.2 <0.1.6-0 || >=0.1.6-0 <0.1.7-0 || >=0.1.7-0 <0.2.0-0 || >=0.2.0-0 <0.2.1-0 || >=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": ">=0.1.5-rc.2 <0.3.0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.1.5-rc.2 <0.3.0",
    "@deepseek-ai/dsh-atomic-write": ">=0.1.5-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-commands": ">=0.1.5-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.5-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-session": ">=0.1.5-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.1.5-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.5-rc.2 <0.3.0",
    "@deepseek-ai/dsh-commands": ">=0.1.5-rc.2 <0.3.0",
    "@deepseek-ai/dsh-home-paths": ">=0.1.5-rc.2 <0.3.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.5-rc.2 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.1.5-rc.2 <0.3.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.5-rc.2 <0.3.0",
    "@deepseek-ai/dsh-timeout": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.2 <0.3.0",
    "@deepseek-ai/schemastery": "3.18.2",
    "@types/node": "^22.20.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3"
  }
}
